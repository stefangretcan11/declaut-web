{
  "name": "declaut-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:database": "tsx --test tests/database/*.test.ts",
    "test:staging": "node --env-file=.env.local --import tsx scripts/smoke-license.ts",
    "test:auth": "playwright test",
    "keys:export": "node scripts/export-public-keys.mjs",
    "auth:configure": "node scripts/configure-auth.mjs",
    "keys:generate": "node scripts/generate-license-key.mjs",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "jose": "^6.2.13",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
