# Use an isolated staging project. jdvurtohbypdlvkirnrm is now production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: dashboard > Settings > API Keys > legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Generate staging values with: npm run keys:generate
# Base64 encodes a PKCS#8 Ed25519 PEM so Vercel needs no multiline secret.
LICENSE_PRIVATE_KEY_BASE64=
LICENSE_KEY_ID=
LICENSE_ISSUER=declaut-staging
LICENSE_AUDIENCE=declaut-desktop

# Public releases repo supplied by Track B.
GITHUB_RELEASES_REPO=mihaicostache1/declaut-release
# Exact Windows installer asset name; optional if the release has one .exe.
GITHUB_RELEASE_ASSET_NAME=declaut-setup.exe
# Stable is the default. Use preview only on staging to include release candidates.
GITHUB_RELEASE_CHANNEL=stable

# Stable public application origin for confirmation/reset email redirects.
# For local development use http://localhost:3000; configure the staging origin on Vercel.
SITE_URL=

# Stripe: test keys only with isolated staging; live keys require production setup.
# Semiannual: RON 300.00, recurring month / interval_count 6.
# Yearly: RON 500.00, recurring year / interval_count 1.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=
# Enable after production license/inbox checks and the accountant's manual invoicing workflow is ready.
BILLING_LIVE_ENABLED=false
# Fiscal invoices are issued separately by the accountant. No invoicing API is required.

# Local setup helpers only. Never export admin tokens or SMTP credentials to Vercel.
SUPABASE_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_ACCEPTANCE_VERIFIED=false

# Public website content. Leave unset until the real details are available.
CONTACT_EMAIL=
COMPANY_LEGAL_NAME=
COMPANY_CUI=
COMPANY_REGISTRATION_NUMBER=
COMPANY_ADDRESS=
# Prices approved by the owner; keep aligned with the configured Stripe prices.
NEXT_PUBLIC_PRO_SEMIANNUAL_PRICE_RON=300
NEXT_PUBLIC_PRO_YEARLY_PRICE_RON=500
